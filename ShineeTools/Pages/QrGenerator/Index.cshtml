@page "/qr-generator"

@using ShineeTools.Core.Pages.QrGenerator
@using ShineeTools.Core.Enums

@model IndexModel

@{
    ViewData["Title"] = "QR Code Generator";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <a asp-page="/Index"
               class="text-primary text-decoration-none d-inline-flex align-items-center gap-2 mb-4">
                <i data-lucide="arrow-left"
                   style="width: 18px; height: 18px;"></i>
                Kembali
            </a>

            <header class="mb-4">
                <h1 class="h2 fw-semibold mb-2">QR Code Generator</h1>
                <p class="text-secondary mb-0">
                    Buat kode QR dari URL dan sesuaikan tampilannya dengan logo pilihanmu.
                </p>
            </header>

            <form method="post" enctype="multipart/form-data">

                <div class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">Informasi QR Code</h2>
                    </div>

                    <div class="card-body">
                        <p class="text-secondary small mb-4">
                            Masukkan alamat tujuan dan tentukan gaya kode QR.
                        </p>

                        <div class="row g-3 align-items-start mb-4">
                            <label asp-for="Input.Url"
                                   class="col-12 col-md-3 col-form-label">
                            </label>

                            <div class="col-12 col-md-9">
                                <input asp-for="Input.Url"
                                       class="form-control"
                                       type="url"
                                       placeholder="https://google.com" />

                                <span asp-validation-for="Input.Url"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 align-items-start">
                            <label asp-for="Input.Style"
                                   class="col-12 col-md-3 col-form-label">
                                Gaya QR Code
                            </label>

                            <div class="col-12 col-md-9">
                                <select asp-for="Input.Style"
                                        asp-items="Html.GetEnumSelectList<QrCodeStyle>()"
                                        class="form-select">
                                </select>

                                <span asp-validation-for="Input.Style"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">Logo QR Code</h2>
                    </div>

                    <div class="card-body">
                        <p class="text-secondary small mb-4">
                            Opsional. Gunakan gambar PNG, JPG, JPEG, atau WebP
                            dengan ukuran maksimal 2 MB.
                        </p>

                        <div class="row g-3 align-items-start">
                            <label asp-for="Input.Logo"
                                   class="col-12 col-md-3 col-form-label">
                                File Logo
                            </label>

                            <div class="col-12 col-md-9">
                                <input asp-for="Input.Logo"
                                       id="fileInput"
                                       type="file"
                                       class="form-control"
                                       accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" />

                                <span asp-validation-for="Input.Logo"
                                      class="text-danger small"></span>

                                <div id="fileInfo"
                                     class="d-none mt-3 p-3 border rounded align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-3 text-truncate">
                                        <div class="flex-shrink-0 text-secondary">
                                            <i data-lucide="file-image"
                                               style="width: 22px; height: 22px;"></i>
                                        </div>

                                        <div class="text-truncate">
                                            <div id="fileName"
                                                 class="text-truncate fw-medium">
                                            </div>

                                            <small id="fileSize"
                                                   class="text-secondary">
                                            </small>
                                        </div>
                                    </div>

                                    <button id="removeFile"
                                            type="button"
                                            class="btn btn-sm btn-outline-danger flex-shrink-0">
                                        <i data-lucide="x"
                                           style="width: 14px; height: 14px;"></i>
                                        Hapus
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            asp-page-handler="Generate"
                            class="btn btn-primary">
                        <i data-lucide="qr-code"
                           class="me-1"
                           style="width: 18px; height: 18px;"></i>
                        Generate QR Code
                    </button>

                    <button type="button"
                            id="downloadQr"
                            class="btn btn-outline-primary"
                            disabled>
                        <i data-lucide="download"
                           class="me-1"
                           style="width: 18px; height: 18px;"></i>
                        Download PNG
                    </button>
                </div>
            </form>

            @if (Model.QrCodeDataUrl is not null)
            {
                <div class="card mt-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">Hasil QR Code</h2>
                    </div>

                    <div class="card-body text-center p-4">
                        <img id="qrCodeImage"
                             src="@Model.QrCodeDataUrl"
                             alt="Kode QR untuk @Model.Input.Url"
                             data-filename="@Model.Input.Url"
                             class="img-fluid border rounded p-3"
                             style="width: 100%; max-width: 300px;" />

                        <p class="text-secondary text-break small mt-3 mb-0">
                            @Model.Input.Url
                        </p>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>

    <script>
        const fileInput = document.getElementById("fileInput");
        const fileInfo = document.getElementById("fileInfo");
        const fileName = document.getElementById("fileName");
        const fileSize = document.getElementById("fileSize");
        const removeFile = document.getElementById("removeFile");
        const downloadButton = document.getElementById("downloadQr");
        const qrImage = document.getElementById("qrCodeImage");

        function updateFileInfo() {
            const file = fileInput.files?.[0];

            if (!file) {
                fileInfo.classList.add("d-none");
                fileInfo.classList.remove("d-flex");
                fileName.textContent = "";
                fileSize.textContent = "";
                return;
            }

            fileName.textContent = file.name;
            fileSize.textContent = `${(file.size / 1024).toFixed(1)} KB`;

            fileInfo.classList.remove("d-none");
            fileInfo.classList.add("d-flex");
        }

        fileInput.addEventListener("change", updateFileInfo);

        removeFile.addEventListener("click", () => {
            fileInput.value = "";
            updateFileInfo();
        });

        downloadButton.disabled = !qrImage;

        downloadButton.addEventListener("click", () => {
            if (!qrImage?.src) return;

            try {
                const url = new URL(qrImage.dataset.filename);
                const hostname = url.hostname.replace(/^www\./, "");
                const filename = `${hostname.replace(/\./g, "-")}-qr.png`;

                const link = document.createElement("a");
                link.href = qrImage.src;
                link.download = filename;

                document.body.appendChild(link);
                link.click();
                link.remove();
            } catch {
                // URL tidak valid; jangan memulai unduhan.
            }
        });

        lucide.createIcons();
    </script>
}