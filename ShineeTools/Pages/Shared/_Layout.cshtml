<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shinee Tools</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QrGenerator.styles.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0074e2" />
    <meta name="description" content="Kumpulan alat online gratis untuk mengolah gambar, PDF, dan berbagai kebutuhan file langsung dari browser." />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <main role="main" class="container flex-grow-1">
        @RenderBody()
    </main>

    <footer class="container border-top pt-3 pb-3 mt-auto">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-secondary">
            <span>&copy; @DateTime.Now.Year ShineeTools</span>
            <div class="d-flex gap-2">
                <a asp-area=""
                    asp-page="/Privacy"
                    class="text-secondary text-decoration-none">
                        Privasi
                </a>
                |
                <a 
                    href="mailto:althafmain@gmail.com"
                    class="text-secondary text-decoration-none">
                        Kontak Kami
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
                navigator.serviceWorker.register("/service-worker.js")
                    .catch(error => console.error(
                        "Service Worker registration failed:", error
                    ));
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
