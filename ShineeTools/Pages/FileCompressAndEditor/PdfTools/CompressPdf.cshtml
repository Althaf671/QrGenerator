@page "/file-tools/compress-pdf"

@{
    ViewData["Title"] = "Compress PDF - Kompress Ukuran PDF Online";
    ViewData["Description"] = "Kompres PDF untuk mengurangi ukuran file secara online. Proses langsung di browser tanpa mengunggah dokumen ke server.";
}

@section Head {
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://shinee.my.id/file-tools/compress-pdf" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ShineeTools" />
    <meta property="og:title" content="Compress PDF - ShineeTools" />
    <meta property="og:description" content="Kurangi ukuran file PDF secara gratis langsung di browser." />
    <meta property="og:url" content="https://shinee.my.id/file-tools/compress-pdf" />
    <meta property="og:image" content="https://shinee.my.id/images/og/compress-pdf.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Compress PDF - ShineeTools" />
    <meta name="twitter:description" content="Kurangi ukuran file PDF secara gratis tanpa mengunggah dokumen ke server." />
    <meta name="twitter:image" content="https://shinee.my.id/images/og/compress-pdf.png" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <!-- Navigasi kembali -->
            <a asp-page="/FileCompressAndEditor/Index"
               class="text-primary text-decoration-none d-inline-flex align-items-center gap-2 mb-4">
                <i data-lucide="arrow-left"
                   style="width: 18px; height: 18px;"></i>
                Kembali ke File Tools
            </a>

            <!-- Header halaman -->
            <header class="mb-4">
                <h1 class="h2 fw-semibold mb-2">Compress PDF</h1>

                <p class="text-secondary mb-0">
                    Kurangi ukuran file PDF agar lebih mudah disimpan,
                    dibagikan, atau dikirim melalui internet.
                </p>
            </header>

            <form id="compressPdfForm" novalidate>

                <!-- Pemilihan file -->
                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            <i data-lucide="file-up"
                               class="me-2"
                               style="width: 18px; height: 18px;"></i>
                            Pilih File PDF
                        </h2>
                    </div>

                    <div class="card-body">
                        <p class="text-secondary small mb-3">
                            Pilih satu file PDF yang ingin dikompres.
                        </p>

                        <label for="pdfFile" class="form-label">
                            File PDF
                        </label>

                        <input id="pdfFile"
                               name="pdfFile"
                               type="file"
                               class="form-control"
                               accept=".pdf,application/pdf"
                               required />

                        <div class="form-text">
                            Format PDF saja. Maksimal 25 MB per file.
                        </div>

                        <div id="pdfStatus"
                             class="alert d-none mt-3 mb-0"
                             role="status"
                             aria-live="polite"></div>

                        <div id="pdfInfoSection" class="d-none mt-4">
                            <h3 class="h6 fw-semibold mb-3">
                                Informasi Dokumen
                            </h3>

                            <div class="border rounded p-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="flex-shrink-0 d-flex align-items-center justify-content-center bg-body-secondary rounded p-2">
                                        <i data-lucide="file-text"
                                           style="width: 22px; height: 22px;"></i>
                                    </div>

                                    <div class="min-w-0 flex-grow-1">
                                        <p id="pdfFileName"
                                           class="fw-medium text-break mb-1"></p>

                                        <p class="text-secondary small mb-0">
                                            <span id="pdfPageCount">0 halaman</span>
                                            <span class="mx-1">·</span>
                                            <span id="pdfFileSize">0 B</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Pengaturan kompresi -->
                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            <i data-lucide="sliders-horizontal"
                               class="me-2"
                               style="width: 18px; height: 18px;"></i>
                            Pengaturan Kompresi
                        </h2>
                    </div>

                    <div class="card-body">
                        <p class="text-secondary small mb-3">
                            Pilih tingkat optimasi sesuai kebutuhan dokumen.
                        </p>

                        <div class="d-grid gap-3">
                            <label class="border rounded p-3">
                                <span class="d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1"
                                           type="radio"
                                           name="compressionLevel"
                                           value="light"
                                           checked />

                                    <span class="flex-grow-1">
                                        <span class="d-flex align-items-center flex-wrap gap-2">
                                            <span class="fw-medium">Ringan</span>

                                            <span class="badge text-bg-light border">
                                                Kualitas diprioritaskan
                                            </span>
                                        </span>

                                        <span class="d-block text-secondary small mt-1">
                                            Pilihan konservatif untuk mencoba
                                            mempertahankan kualitas dokumen.
                                        </span>
                                    </span>
                                </span>
                            </label>

                            <label class="border rounded p-3">
                                <span class="d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1"
                                           type="radio"
                                           name="compressionLevel"
                                           value="recommended" />

                                    <span class="flex-grow-1">
                                        <span class="fw-medium">
                                            Direkomendasikan
                                        </span>

                                        <span class="d-block text-secondary small mt-1">
                                            Pilihan seimbang untuk penggunaan
                                            dokumen sehari-hari.
                                        </span>
                                    </span>
                                </span>
                            </label>

                            <label class="border rounded p-3">
                                <span class="d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1"
                                           type="radio"
                                           name="compressionLevel"
                                           value="maximum" />

                                    <span class="flex-grow-1">
                                        <span class="fw-medium">Maksimum</span>

                                        <span class="d-block text-secondary small mt-1">
                                            Prioritaskan pengurangan ukuran file,
                                            dengan kemungkinan penurunan kualitas visual.
                                        </span>
                                    </span>
                                </span>
                            </label>
                        </div>

                        <div class="alert alert-light border small mt-4 mb-0"
                             role="note">
                            <i data-lucide="info"
                               class="me-1"
                               style="width: 16px; height: 16px;"></i>

                            Hasil kompresi bergantung pada isi dan struktur PDF.
                            Ukuran file tidak selalu dapat dikurangi.
                        </div>
                    </div>
                </section>

                <!-- Pengaturan nama hasil -->
                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            <i data-lucide="file-output"
                               class="me-2"
                               style="width: 18px; height: 18px;"></i>
                            Pengaturan Hasil
                        </h2>
                    </div>

                    <div class="card-body">
                        <div class="mb-3">
                            <label for="outputFilename" class="form-label">
                                Nama file hasil
                            </label>

                            <div class="input-group">
                                <input id="outputFilename"
                                       name="outputFilename"
                                       type="text"
                                       class="form-control"
                                       value="compressed-document"
                                       maxlength="100"
                                       placeholder="compressed-document" />

                                <span class="input-group-text">.pdf</span>
                            </div>

                            <div class="form-text">
                                Ekstensi .pdf ditambahkan secara otomatis.
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Ringkasan -->
                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            Ringkasan Dokumen
                        </h2>
                    </div>

                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Ukuran awal</span>
                            <span id="summaryOriginalSize"
                                  class="fw-medium text-end">-</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Ukuran hasil</span>
                            <span id="summaryCompressedSize"
                                  class="fw-medium text-end">-</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Penghematan ukuran</span>
                            <span id="summaryReduction"
                                  class="fw-medium text-end">-</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Status</span>
                            <span id="summaryReadyStatus"
                                  class="fw-medium text-end">Belum siap</span>
                        </div>
                    </div>
                </section>

                <!-- Aksi -->
                <div class="d-flex flex-wrap gap-2">
                    <button id="compressPdf"
                            type="submit"
                            class="btn btn-primary"
                            disabled>
                        <i data-lucide="file-down"
                           class="me-1"
                           style="width: 18px; height: 18px;"></i>
                        Kompres PDF
                    </button>

                    <button id="resetCompress"
                            type="button"
                            class="btn btn-outline-secondary">
                        <i data-lucide="rotate-ccw"
                           class="me-1"
                           style="width: 18px; height: 18px;"></i>
                        Reset
                    </button>
                </div>
            </form>

            <!-- Hasil pemrosesan dan download -->
            <div id="pdfResultActions" class="mt-3 d-none">
                <button id="downloadPdf"
                        type="button"
                        class="btn btn-outline-primary">
                    <i data-lucide="download"
                       class="me-1"
                       style="width: 18px; height: 18px;"></i>
                    Download PDF
                </button>
            </div>

            <!-- Informasi penggunaan -->
            <section class="mt-5">
                <h2 class="h5 fw-semibold mb-3">
                    Cara Mengompres File PDF
                </h2>

                <ol class="ps-3 mb-4">
                    <li class="mb-2">
                        <strong>Pilih file PDF.</strong>
                        Masukkan dokumen yang ingin dikurangi ukurannya.
                    </li>
                    <li class="mb-2">
                        <strong>Pilih tingkat kompresi.</strong>
                        Sesuaikan pengaturan dengan kebutuhan dokumen.
                    </li>
                    <li class="mb-2">
                        <strong>Tentukan nama hasil.</strong>
                        Masukkan nama file PDF yang akan diunduh.
                    </li>
                    <li>
                        <strong>Proses dan unduh.</strong>
                        Tekan Kompres PDF untuk membuat file hasil.
                    </li>
                </ol>

                <h2 class="h5 fw-semibold mb-3">
                    Apakah File Saya Aman?
                </h2>

                <p class="text-secondary mb-0">
                    ShineeTools dirancang untuk memproses PDF langsung di browser.
                    Dokumen tidak perlu dikirim ke server untuk diproses.
                </p>
            </section>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script src="~/js/pdf-tools-scripts/compress-pdf.js" asp-append-version="true"></script>

    <script>
        if (window.pdfjsLib) {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc =
                "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
        }

        if (window.lucide) {
            window.lucide.createIcons();
        }
    </script>
}