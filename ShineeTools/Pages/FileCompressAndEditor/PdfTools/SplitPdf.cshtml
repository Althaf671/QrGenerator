@page "/file-tools/split-pdf"

@{
    ViewData["Title"] = "Split PDF - Pisahkan Halaman PDF Online";
    ViewData["Description"] = "Pisahkan halaman PDF menjadi file terpisah atau ekstrak halaman tertentu. Proses langsung di browser tanpa mengunggah dokumen ke server.";
}

@section Head {
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://shinee.my.id/file-tools/split-pdf" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ShineeTools" />
    <meta property="og:title" content="Split PDF - ShineeTools" />
    <meta property="og:description" content="Pisahkan halaman PDF atau ekstrak halaman tertentu secara gratis langsung di browser." />
    <meta property="og:url" content="https://shinee.my.id/file-tools/split-pdf" />
    <meta property="og:image" content="https://shinee.my.id/images/og/split-pdf.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Split PDF - ShineeTools" />
    <meta name="twitter:description" content="Pisahkan halaman PDF menjadi file terpisah atau ekstrak halaman pilihan." />
    <meta name="twitter:image" content="https://shinee.my.id/images/og/split-pdf.png" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <a asp-page="/FileCompressAndEditor/Index"
               class="text-primary text-decoration-none d-inline-flex align-items-center gap-2 mb-4">
                <i data-lucide="arrow-left"
                   style="width: 18px; height: 18px;"></i>
                Kembali ke File Tools
            </a>

            <header class="mb-4">
                <h1 class="h2 fw-semibold mb-2">Split PDF</h1>

                <p class="text-secondary mb-0">
                    Pisahkan halaman PDF menjadi beberapa file atau ekstrak
                    halaman tertentu sesuai kebutuhan.
                </p>
            </header>

            <form id="splitPdfForm">

                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            <i data-lucide="file-up"
                               class="me-2"
                               style="width: 18px; height: 18px;"></i>
                            Pilih File PDF
                        </h2>
                    </div>

                    <div class="card-body">
                        <p class="text-secondary small mb-3">
                            Pilih satu file PDF yang ingin dipisahkan.
                        </p>

                        <label for="pdfFile" class="form-label">
                            File PDF
                        </label>

                        <input id="pdfFile"
                               name="pdfFile"
                               type="file"
                               class="form-control"
                               accept=".pdf,application/pdf" />

                        <div class="form-text">
                            Format PDF saja. Maksimal 25 MB per file.
                        </div>

                        <div id="pdfStatus"
                             class="alert d-none mt-3 mb-0"
                             role="status"
                             aria-live="polite"></div>

                        <div id="pdfInfoSection" class="d-none mt-4">
                            <h3 class="h6 fw-semibold mb-3">
                                Informasi Dokumen
                            </h3>

                            <div class="border rounded p-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="flex-shrink-0 d-flex align-items-center justify-content-center bg-body-secondary rounded p-2">
                                        <i data-lucide="file-text"
                                        style="width: 22px; height: 22px;"></i>
                                    </div>

                                    <div class="min-w-0">
                                        <p id="pdfFileName"
                                        class="fw-medium text-break mb-1"></p>

                                        <p class="text-secondary small mb-0">
                                            <span id="pdfPageCount">0 halaman</span>
                                            <span class="mx-1">·</span>
                                            <span id="pdfFileSize">0 B</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            <i data-lucide="scissors"
                               class="me-2"
                               style="width: 18px; height: 18px;"></i>
                            Pengaturan Pemisahan
                        </h2>
                    </div>

                    <div class="card-body">
                        <label class="form-label">
                            Mode pemisahan
                        </label>

                        <div class="d-grid gap-3 mb-4">
                            <label class="border rounded p-3">
                                <span class="d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1"
                                           type="radio"
                                           name="splitMode"
                                           value="all"
                                           checked />

                                    <span>
                                        <span class="d-block fw-medium">
                                            Pisahkan semua halaman
                                        </span>
                                        <span class="d-block text-secondary small mt-1">
                                            Setiap halaman menjadi file PDF tersendiri.
                                            Semua hasil diunduh dalam satu file ZIP.
                                        </span>
                                    </span>
                                </span>
                            </label>

                            <label class="border rounded p-3">
                                <span class="d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1"
                                           type="radio"
                                           name="splitMode"
                                           value="extract" />

                                    <span>
                                        <span class="d-block fw-medium">
                                            Ekstrak halaman tertentu
                                        </span>
                                        <span class="d-block text-secondary small mt-1">
                                            Pilih halaman yang ingin dipertahankan
                                            dalam satu PDF baru.
                                        </span>
                                    </span>
                                </span>
                            </label>
                        </div>

                        <div id="pageRangeSection" class="d-none mb-3">
                            <label for="pageRange" class="form-label">
                                Rentang halaman
                            </label>

                            <input id="pageRange"
                                   type="text"
                                   class="form-control"
                                   placeholder="Contoh: 1-3, 5, 8-10"
                                   autocomplete="off" />

                            <div class="form-text">
                                Nomor halaman dimulai dari 1.
                                Pisahkan pilihan dengan koma dan gunakan tanda
                                hubung untuk rentang halaman.
                            </div>
                        </div>

                        <div id="splitHint"
                             class="text-secondary small">
                            Dokumen akan dipisahkan menjadi satu PDF per halaman.
                        </div>
                    </div>
                </section>

                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            <i data-lucide="file-output"
                               class="me-2"
                               style="width: 18px; height: 18px;"></i>
                            Pengaturan Hasil
                        </h2>
                    </div>

                    <div class="card-body">
                        <div class="mb-3">
                            <label for="outputFilename" class="form-label">
                                Nama file hasil
                            </label>

                            <div class="input-group">
                                <input id="outputFilename"
                                       type="text"
                                       class="form-control"
                                       value="split-document"
                                       maxlength="100"
                                       placeholder="split-document" />

                                <span class="input-group-text">.pdf / .zip</span>
                            </div>

                            <div class="form-text mt-3">
                                Mode ekstrak menghasilkan file PDF.
                                Mode pisahkan semua halaman menghasilkan file ZIP.
                                Ekstensi ditambahkan secara otomatis.
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card mb-4">
                    <div class="card-header py-3">
                        <h2 class="h6 fw-semibold mb-0">
                            Ringkasan Dokumen
                        </h2>
                    </div>

                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Jumlah halaman sumber</span>
                            <span id="summaryPageCount" class="fw-medium">-</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Halaman yang diproses</span>
                            <span id="summarySelectedPages" class="fw-medium">-</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Format hasil</span>
                            <span id="summaryOutputFormat" class="fw-medium">ZIP</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
                            <span class="text-secondary">Status</span>
                            <span id="summaryReadyStatus" class="fw-medium">
                                Belum siap
                            </span>
                        </div>
                    </div>
                </section>

                <div class="d-flex flex-wrap gap-2">
                    <button id="splitPdf"
                            type="submit"
                            class="btn btn-primary"
                            disabled>
                        <i data-lucide="scissors"
                           class="me-1"
                           style="width: 18px; height: 18px;"></i>
                        Pisahkan PDF
                    </button>

                    <button id="resetSplit"
                            type="button"
                            class="btn btn-outline-secondary">
                        <i data-lucide="rotate-ccw"
                           class="me-1"
                           style="width: 18px; height: 18px;"></i>
                        Reset
                    </button>
                </div>
            </form>

            <section class="mt-5">
                <h2 class="h5 fw-semibold mb-3">
                    Cara Memisahkan File PDF
                </h2>

                <ol class="ps-3 mb-4">
                    <li class="mb-2">
                        <strong>Pilih file PDF.</strong>
                        Unggah satu dokumen yang ingin dipisahkan.
                    </li>
                    <li class="mb-2">
                        <strong>Pilih mode pemisahan.</strong>
                        Pisahkan seluruh halaman atau ekstrak halaman tertentu.
                    </li>
                    <li class="mb-2">
                        <strong>Tentukan nama hasil.</strong>
                        Masukkan nama file PDF atau ZIP yang akan diunduh.
                    </li>
                    <li>
                        <strong>Proses dan unduh.</strong>
                        Tekan Pisahkan PDF untuk membuat file hasil.
                    </li>
                </ol>

                <h2 class="h5 fw-semibold mb-3">
                    Apakah File Saya Aman?
                </h2>

                <p class="text-secondary mb-0">
                    Pemisahan PDF dirancang berlangsung langsung di browser
                    menggunakan JavaScript. Dokumen tidak perlu dikirim
                    ke server untuk diproses.
                </p>
            </section>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="~/js/pdf-tools-scripts/split-pdf.js"
            asp-append-version="true"></script>

    <script>
        lucide.createIcons();
    </script>
}